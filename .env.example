DATABASE_URL=postgresql+psycopg://commerceops:commerceops@db:5432/commerceops
POPIFY_ENV=development
APP_SECRET=change-me-in-real-use
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=demo-change-me
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=local-demo-secret
ORDER_DELAY_HOURS=48
MOCK_ACTION_FAILURES=0
N8N_ENCRYPTION_KEY=replace-with-random-key-before-sharing
MOCK_ACTION_AMBIGUOUS=false
MAX_ACTION_ATTEMPTS=3

# Scheduled retries: exponential backoff, capped at 1 hour.
MAX_DELIVERY_ATTEMPTS=3
RETRY_BASE_SECONDS=30
# Mock equivalent of a provider's Retry-After minimum delay.
MOCK_RETRY_AFTER_SECONDS=0
# Optional JSON object with all five categories; defaults are in app/config.py.
# STORE_POLICIES={"refund":"...","cancellation":"...","damaged_item":"...","order_status":"...","other":"..."}
